{
  "name": "hacknu-x-whd",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev --port 3000 --strictPort",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm install && npm run build && wrangler deploy",
    "auth:generate": "npx @better-auth/cli generate --config ./src/lib/auth.ts --output src/db/auth-schema.ts -y",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:studio:local": "drizzle-kit studio --config drizzle.config.local.ts",
    "db:studio:remote": "drizzle-kit studio",
    "types": "wrangler types",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/lexend": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@tanstack/react-query": "^5.103.2",
    "@tanstack/react-router": "^1.170.38",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.57",
    "better-auth": "^1.7.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "i18next": "^25.8.14",
    "i18next-browser-languagedetector": "^8.2.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.55.0",
    "motion": "^12.35.2",
    "radix-ui": "^1.8.0",
    "react": "~19.2.8",
    "react-dom": "~19.2.8",
    "react-i18next": "^16.5.4",
    "react-icons": "^5.7.0",
    "tailwind-merge": "^3.5.0",
    "web-haptics": "^0.0.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@better-auth/cli": "^1.4.22",
    "@cloudflare/vite-plugin": "^1.57.3",
    "@cloudflare/workers-types": "^5.20260922.1",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.1",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-devtools": "^0.10.13",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.40",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^25.3.3",
    "@types/react": "~19.2.14",
    "@types/react-dom": "~19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.12.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "sharp": "^0.35.5",
    "svgo": "^4.1.0",
    "tailwindcss": "^4.2.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.11",
    "wrangler": "^4.136.3"
  }
}
