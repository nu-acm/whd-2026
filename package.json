{
  "name": "hacknu-x-whd",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.21.0"
  },
  "scripts": {
    "dev": "vp dev",
    "build": "vp build",
    "preview": "vp build && vp preview",
    "deploy": "vp build && wrangler deploy",
    "auth:generate": "auth generate --config ./src/lib/auth.ts --adapter drizzle --dialect sqlite --output src/db/auth-schema.ts -y",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:studio:local": "drizzle-kit studio --config drizzle.config.local.ts",
    "db:studio:remote": "drizzle-kit studio",
    "types": "wrangler types",
    "test": "vp test",
    "test:watch": "vp test watch",
    "typecheck": "tsc --noEmit",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "test:e2e": "vp build && playwright test"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
