    "i18next": "^26.4.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.56.0",
    "motion": "^14.2.0",
    "react": "~19.3.0",
    "react-dom": "~19.3.0",
    "react-i18next": "^17.0.16",
    "react-icons": "^5.7.0",
    "web-haptics": "^0.0.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
