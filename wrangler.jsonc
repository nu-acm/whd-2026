{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whd-2026",
  // The nu-acm account, so wrangler never asks which account to use (or reuses a cached choice).
  "account_id": "f4071f1b770277fe78925ee11779e59d",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "whd.nuacmw.kz",
      "zone_name": "nuacmw.kz",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false,
    },
  ],
  "vars": {
    "BETTER_AUTH_URL": "https://whd.nuacmw.kz",
    // Blank uses the event deadline. A var, so .dev.vars can still override it (see secrets below).
    "REGISTRATION_DEADLINE": "",
  },
  // A deploy fails while any of these is not set on the Worker. Local dev only warns, and loads only
  // these names and the vars above from .dev.vars.
  "secrets": {
    "required": [
      "BETTER_AUTH_SECRET",
      "GAS_URL",
      "GAS_SECRET",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "ADMIN_EMAILS",
    ],
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whd-2026",
      "database_id": "d61783dd-35a8-40ad-938e-ea0de4327c4e",
      "migrations_dir": "drizzle",
    },
  ],
  // Workers AI, for the dashboard's "generate a team name" button.
  "ai": {
    "binding": "AI",
  },
}
