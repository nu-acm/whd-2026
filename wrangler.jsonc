{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whd-2026",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "vars": {
    "BETTER_AUTH_URL": "https://whd.nuacmw.kz",
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whd-2026",
      "database_id": "d61783dd-35a8-40ad-938e-ea0de4327c4e",
      "migrations_dir": "drizzle",
    },
  ],
  // Workers AI, for the dashboard's "generate a team name" button.
  "ai": {
    "binding": "AI",
  },
}
